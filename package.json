{
  "name": "distributed-work-platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "db:up": "docker compose up -d && node scripts/wait-for-db.mjs",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && pnpm db:up",
    "control": "node --env-file-if-exists=.env packages/control/src/index.ts",
    "agent": "node --env-file-if-exists=.env packages/agent/src/index.ts",
    "tunnel": "cloudflared tunnel --url http://localhost:8787",
    "typecheck": "tsc --build --force",
    "verify-run": "node scripts/verify-run.ts",
    "share": "node scripts/share.ts",
    "logs": "node scripts/watch-log.ts",
    "sim": "node sim/run.ts",
    "sim:edge": "node sim/edge-cases.ts"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "@types/pg": "8.15.6"
  },
  "dependencies": {
    "@dwp/protocol": "workspace:*",
    "pg": "8.23.0",
    "ws": "8.21.3"
  }
}
