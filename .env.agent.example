# Configuration for one containerised agent. Copy to .env.agent and fill in.
#
#   docker compose --env-file .env.agent -f deploy/compose.agent.yaml up -d --build

# The invite link you were sent. It expires ten minutes after it was created and works
# exactly once, so fetch a fresh one if the container reports it was not accepted.
DWP_INVITE=https://your-control-service.example.com/join?code=ABCDEF

# What this machine should be called on the dashboard.
DWP_LABEL=

# Which host port the window is published on. Change it when running more than one agent
# on the same host; the container always listens on 43117 inside.
DWP_GUI_PUBLISH_PORT=43117

# How much of this machine the agent may use.
DWP_CPUS=2.0
DWP_MEMORY=1g

# Reach the window by a name other than localhost — a tailnet name, say. Comma
# separated, names only.
DWP_GUI_ALLOWED_HOSTS=
