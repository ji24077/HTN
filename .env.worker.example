# Copy to .env.worker (ignored). Use only this worker's credentials here.
WORKER_TRANSPORT=tailscale
SERVER_URL=wss://YOUR-SERVER.YOUR-TAILNET.ts.net:8443/v1/worker
WORKER_ID=worker-1
WORKER_TOKEN=replace-with-its-enrolled-token
WORKER_RUNTIME=cpu
WORKER_VRAM_MIB=0
# Optional Sentry reporting (the htn-backend DSN); blank disables it.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
TAILSCALE_HOSTNAME=orch-worker-1
# Local build; omit this line in the bundled Docker image.
TAILSCALE_HELPER=.local/bin/orchestrator-tunnel
TAILSCALE_STATE_DIR=.local/tailscale/worker-1
# Optional initial enrollment. Leave blank to receive a browser sign-in link.
# Generate a worker-scoped, single-use auth key in your tailnet; never commit it.
TS_AUTHKEY=
