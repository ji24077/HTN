# Public website + Supabase; run uv commands from the repository root with --project backend --env-file .env.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_ADMIN_IDS=
# Approved accounts must confirm their email before receiving fleet access.
SUPABASE_ADMIN_EMAILS=
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:URL_ENCODED_PASSWORD@YOUR-SESSION-POOLER:5432/postgres?sslmode=verify-full&sslrootcert=/absolute/path/to/supabase-ca.crt
DATABASE_SCHEMA=orchestrator
PUBLIC_ORIGIN=https://fleet.example.com
# Optional: Vite HTTPS for running the authenticated app on localhost.
# FRONTEND_TLS_CERT_FILE=.local/tls/localhost.pem
# FRONTEND_TLS_KEY_FILE=.local/tls/localhost-key.pem
PUBLIC_PORT=8080
WORKER_PORT=8081
WORKER_TOKENS={"worker-1":"replace-with-a-random-worker-token"}
# Optional automation key; browser login uses Supabase.
ADMIN_TOKEN=
REDIS_URL=

# Bundled backend network; leave TS_AUTHKEY blank for browser enrollment.
TAILSCALE_HELPER=.local/bin/orchestrator-tunnel
TAILSCALE_HOSTNAME=orch-backend
TAILSCALE_STATE_DIR=.local/tailscale/backend
TS_AUTHKEY=
