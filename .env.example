# Public website + Supabase; run uv commands from the repository root with --project backend --env-file .env.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_ADMIN_IDS=
# Approved accounts must confirm their email before receiving fleet access.
SUPABASE_ADMIN_EMAILS=
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:URL_ENCODED_PASSWORD@YOUR-SESSION-POOLER:5432/postgres?sslmode=verify-full&sslrootcert=/absolute/path/to/supabase-ca.crt
DATABASE_SCHEMA=orchestrator
PUBLIC_ORIGIN=https://fleet.example.com
# Optional: Vite HTTPS for running the authenticated app on localhost.
# FRONTEND_TLS_CERT_FILE=.local/tls/localhost.pem
# FRONTEND_TLS_KEY_FILE=.local/tls/localhost-key.pem
PUBLIC_PORT=8080
WORKER_PORT=8081
# Service hosting: use the same random secret in both backend listeners.
SERVICE_BRIDGE_TOKEN=
SERVICE_BRIDGE_URL=http://127.0.0.1:8081
WORKER_TOKENS={"worker-1":"replace-with-a-random-worker-token"}
# Optional automation key; browser login uses Supabase.
ADMIN_TOKEN=
REDIS_URL=

# Optional fleet assistant; backend only. Model calls run when a user sends a message.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Job supervisors use the same model configuration, starting on new submissions.
SUPERVISOR_ENABLED=true
# Optional read-only Sentry retrieval (separate from the public ingest DSN).
SENTRY_API_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_API_URL=https://sentry.io

# Optional Sentry reporting; blank disables it. See docs/sentry.md.
SENTRY_DSN=
SENTRY_FRONTEND_DSN=
# Installed workers inherit SENTRY_DSN through pairing/enrollment. Optional override:
# SENTRY_WORKER_DSN=                  # Explicit blank disables managed worker reporting.
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=

# Optional device workload/release directories; defaults are repo fixtures/ and releases/.
# DWP_FIXTURES_DIR=/absolute/path/to/fixtures
# DWP_RELEASES_DIR=/absolute/path/to/releases

# Bundled backend network; leave TS_AUTHKEY blank for browser enrollment.
TAILSCALE_HELPER=.local/bin/orchestrator-tunnel
TAILSCALE_HOSTNAME=orch-backend
TAILSCALE_STATE_DIR=.local/tailscale/backend
TS_AUTHKEY=

# Automatic worker enrollment (backend only; never copy OAuth secrets to workers).
TAILSCALE_OAUTH_CLIENT_ID=
TAILSCALE_OAUTH_CLIENT_SECRET=
TAILSCALE_ENROLLMENT_TAG=tag:htn-worker
WORKER_GATEWAY_URL=wss://YOUR-BACKEND.YOUR-TAILNET.ts.net:8443/v1/worker

# Opt-in local development executor for uploaded Python simulations.
# Dependencies must already exist on the worker; production sandboxing is separate.
# WORKER_EXECUTOR=python_project
