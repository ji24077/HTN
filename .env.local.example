# Local development only. Replace both tokens before starting anything.
ADMIN_TOKEN=replace-with-a-random-admin-token
WORKER_TOKEN=replace-with-a-random-worker-token
WORKER_ID=worker-1
# For running the server directly; Compose constructs this from WORKER_TOKEN.
WORKER_TOKENS={"worker-1":"replace-with-a-random-worker-token"}
DATABASE_URL=postgres://orchestrator:local-prototype@127.0.0.1:54329/orchestrator?sslmode=disable
REDIS_URL=redis://127.0.0.1:63799/0
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8080
SERVER_URL=ws://127.0.0.1:8080/v1/worker
# Client/CLI URL; ORCHESTRATOR_TOKEN may override ADMIN_TOKEN for client calls.
ORCHESTRATOR_URL=http://127.0.0.1:8080
WORKER_RUNTIME=cpu
WORKER_VRAM_MIB=0
WORKER_PAUSED=false
